{
  "name": "@wato787/microcms-cli",
  "version": "0.1.3",
  "description": "AI-friendly CLI tool for microCMS, built with Bun",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "microcms": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "bun src/index.ts",
    "start": "node dist/index.js",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "compile": "bun build ./src/index.ts --compile --outfile microcms",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^17.3.1",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.13",
    "@typescript/native-preview": "^7.0.0-dev.20260220.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "microcms",
    "cli",
    "bun",
    "typescript",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wato787/microcms-cli.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
