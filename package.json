{
  "name": "@your-user-name/microcms-cli",
  "version": "0.1.0",
  "description": "AI-friendly CLI tool for microCMS, built with Bun",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "microcms-cli": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "bun build --typecheck src/index.ts",
    "compile": "bun build ./src/index.ts --compile --outfile microcms-cli"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "microcms",
    "cli",
    "bun",
    "typescript",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  }
}
